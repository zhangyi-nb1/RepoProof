 app.middleware("http")(tenant_middleware)
 
+# =====================================================
+# Deep Research API (feature-flagged)
+# =====================================================
+if os.environ.get("OFFERCLAW_DEEP_RESEARCH", "").strip().lower() in ("1", "true", "yes", "on"):
+    from research_jobs import create_job as _research_create_job, get_job as _research_get_job, cancel_job as _research_cancel_job, promote_job as _research_promote_job
+
+    class ResearchCreateRequest(BaseModel):
+        input_text: str = ""
+        jd_text: str = ""
+        company_name: str = ""
+        page_url: str = ""
+        model: str = ""
+        search_api: str = "none"
+
+    @app.post("/api/research")
+    async def create_research(req: ResearchCreateRequest):
+        try:
+            return _research_create_job(req.model_dump())
+        except ValueError as e:
+            raise HTTPException(status_code=400, detail=str(e)) from e
+
+    @app.get("/api/research/{job_id}")
+    async def get_research(job_id: str):
+        job = _research_get_job(job_id)
+        if not job:
+            raise HTTPException(status_code=404, detail="research job not found")
+        return job
+
+    @app.post("/api/research/{job_id}/cancel")
+    async def cancel_research(job_id: str):
+        job = _research_cancel_job(job_id)
+        if not job:
+            raise HTTPException(status_code=404, detail="research job not found")
+        return job
+
+    @app.post("/api/research/{job_id}/promote")
+    async def promote_research(job_id: str):
+        try:
+            out = _research_promote_job(job_id)
+        except ValueError as e:
+            raise HTTPException(status_code=409, detail=str(e)) from e
+        if not out:
+            raise HTTPException(status_code=404, detail="research job not found")
+        return out
+
 _log = get_logger("offerclaw.api")
 
