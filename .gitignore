# --- secrets & local config (never commit) ---
.env*
!.env.example
*.pem
*.key
*.p12
credentials*
secrets*

# --- python ---
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# --- databases ---
*.db
*.sqlite3

# --- run data (Adoption Bundle raw runtime data is NOT committed
