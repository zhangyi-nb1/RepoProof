{
 "manifest_version": 1,
 "name": "xmltodict-tool",
 "version": "1.0.0",
 "summary": "将本地 XML 文件离线转换为规范化 JSON 文本。",
 "source": {
  "url": "https://github.com/martinblech/xmltodict",
  "resolved_commit": "6e29fba282e68631034dd2722a413b4e35276584",
  "license": "MIT",
  "distribution": "xmltodict"
 },
 "interface": {
  "usage": "xmltodict-tool <input> [--out FILE]",
  "input": {
   "kind": "file",
   "format": "XML"
  },
  "output": {
   "kind": "stdout",
   "format": "JSON"
  },
  "exit_codes": {
   "0": "success",
   "1": "user_error",
   "2": "internal_error"
  }
 },
 "runtime": {
  "python": "3.12",
  "cpu_only": true,
  "offline": true
 },
 "verification": null
}
