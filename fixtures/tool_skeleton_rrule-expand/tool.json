{
 "manifest_version": 1,
 "name": "rrule-expand",
 "version": "1.0.0",
 "summary": "把 DTSTART+RRULE 两行文本展开为前 10 次发生时间",
 "source": {
  "url": "https://github.com/dateutil/dateutil",
  "resolved_commit": "48bd1af97e71baf8e96fce5b663d589caac8f147",
  "license": "Apache-2.0",
  "distribution": "python-dateutil"
 },
 "contract_schema_version": 2,
 "interface": {
  "usage": "rrule-expand <input.txt> [--out FILE]",
  "input": {
   "kind": "file",
   "format": "TXT",
   "contract": null
  },
  "output": {
   "kind": "stdout",
   "format": "text",
   "contract": {
    "media_type": "text/plain",
    "root_type": "text",
    "required": {}
   }
  },
  "exit_codes": {
   "0": "success",
   "1": "user_error",
   "2": "internal_error"
  }
 },
 "capability": {
  "output_schema": "OccurrenceLines"
 },
 "runtime": {
  "python": "3.12",
  "cpu_only": true,
  "offline": true
 },
 "verification": null
}
