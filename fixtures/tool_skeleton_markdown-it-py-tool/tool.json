{
 "manifest_version": 1,
 "name": "markdown-it-py-tool",
 "version": "1.0.0",
 "summary": "解析 UTF-8 Markdown，并按源码顺序生成包含标题、链接与 fenced code block 的确定性结构化 JSON。",
 "source": {
  "url": "https://github.com/executablebooks/markdown-it-py",
  "resolved_commit": "36c5f547144df2d01970a5792d68c71a3380b227",
  "license": "MIT",
  "distribution": "markdown-it-py"
 },
 "contract_schema_version": 2,
 "interface": {
  "usage": "markdown-it-py-tool <input> [--out FILE]",
  "input": {
   "kind": "file",
   "format": "Markdown (UTF-8)",
   "contract": null
  },
  "output": {
   "kind": "stdout",
   "format": "JSON",
   "contract": {
    "media_type": "application/json",
    "root_type": "object",
    "required": {
     "headings": "array",
     "links": "array",
     "code_blocks": "array"
    }
   }
  },
  "exit_codes": {
   "0": "success",
   "1": "user_error",
   "2": "internal_error"
  }
 },
 "capability": {
  "output_schema": "MarkdownStructure"
 },
 "runtime": {
  "python": "3.12",
  "cpu_only": true,
  "offline": true
 },
 "verification": null
}
