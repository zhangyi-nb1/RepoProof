{
 "manifest_version": 1,
 "name": "opencc-tool",
 "version": "1.0.0",
 "summary": "将简体中文纯文本文件离线、确定性地转换为繁体中文文本。",
 "source": {
  "url": "https://github.com/yichen0831/opencc-python",
  "resolved_commit": "b85452e384a3650109809fe5fefacb2ae4fe89d2",
  "license": "Apache-2.0",
  "distribution": "opencc-python-reimplemented"
 },
 "interface": {
  "usage": "opencc-python-reimplemented-tool <input> [--out FILE]",
  "input": {
   "kind": "file",
   "format": "TXT"
  },
  "output": {
   "kind": "stdout",
   "format": "TXT"
  },
  "exit_codes": {
   "0": "success",
   "1": "user_error",
   "2": "internal_error"
  }
 },
 "runtime": {
  "python": "3.12",
  "cpu_only": true,
  "offline": true
 },
 "verification": null
}
