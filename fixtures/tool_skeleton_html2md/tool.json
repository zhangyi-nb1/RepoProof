{
 "manifest_version": 1,
 "name": "html2md",
 "version": "1.0.0",
 "summary": "将单个 HTML 文件离线转换为干净、稳定的 Markdown 文本。",
 "source": {
  "url": "https://github.com/matthewwithanm/python-markdownify",
  "resolved_commit": "93418550746de58c9180c4cc6fda7520581b03cb",
  "license": "MIT",
  "distribution": "markdownify"
 },
 "interface": {
  "usage": "html2md <input.html> [--out FILE]",
  "input": {
   "kind": "file",
   "format": "HTML"
  },
  "output": {
   "kind": "stdout",
   "format": "Markdown"
  },
  "exit_codes": {
   "0": "success",
   "1": "user_error",
   "2": "internal_error"
  }
 },
 "runtime": {
  "python": "3.12",
  "cpu_only": true,
  "offline": true
 },
 "verification": null
}
