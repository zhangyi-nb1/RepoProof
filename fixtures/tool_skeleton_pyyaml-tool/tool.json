{
 "manifest_version": 1,
 "name": "pyyaml-tool",
 "version": "1.0.0",
 "summary": "安全解析 YAML 文件并输出语义等价、确定性的 JSON 文本",
 "source": {
  "url": "https://github.com/yaml/pyyaml",
  "resolved_commit": "49790e73684bebad1df05ef8d828fa12f685bffb",
  "license": "MIT",
  "distribution": "PyYAML"
 },
 "interface": {
  "usage": "pyyaml-tool <input> [--out FILE]",
  "input": {
   "kind": "file",
   "format": "YAML"
  },
  "output": {
   "kind": "stdout",
   "format": "JSON"
  },
  "exit_codes": {
   "0": "success",
   "1": "user_error",
   "2": "internal_error"
  }
 },
 "runtime": {
  "python": "3.12",
  "cpu_only": true,
  "offline": true
 },
 "verification": null
}
