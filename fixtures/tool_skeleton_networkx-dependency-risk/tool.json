{
 "manifest_version": 1,
 "name": "networkx-dependency-risk",
 "version": "1.0.0",
 "summary": "将任务依赖 CSV 转成可粘贴到表格软件的确定性 TSV 风险清单，标出直接依赖、直接后继、下游影响、可开工状态与循环。",
 "source": {
  "url": "https://github.com/networkx/networkx",
  "resolved_commit": "7530809bfa1ea7ed6fdf918a4d1431488953cb1f",
  "license": "BSD",
  "distribution": "networkx"
 },
 "contract_schema_version": 3,
 "interface": {
  "usage": "networkx-dependency-risk <input> [--out FILE]",
  "input": {
   "kind": "file",
   "format": "CSV 任务依赖表",
   "contract": null
  },
  "output": {
   "kind": "stdout",
   "format": "TSV",
   "contract": {
    "media_type": "text/tab-separated-values",
    "root_type": "text",
    "required": {},
    "validation_profile": "tsv_table_v1"
   }
  },
  "exit_codes": {
   "0": "success",
   "1": "user_error",
   "2": "internal_error"
  }
 },
 "capability": {
  "output_schema": "NetworkXDependencyRiskTsv"
 },
 "runtime": {
  "python": "3.12",
  "cpu_only": true,
  "offline": true
 },
 "verification": null
}
