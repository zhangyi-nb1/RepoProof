{
 "manifest_version": 1,
 "name": "pint-field-kit",
 "version": "1.0.0",
 "summary": "将实验耗材 TSV 按组数与目标单位换算为可离线打开、逐行保留成功和稳定错误状态的现场准备单。",
 "source": {
  "url": "https://github.com/hgrecco/pint",
  "resolved_commit": "5e79411e1be2dc39c52a536168338773b49fd512",
  "license": "BSD",
  "distribution": "Pint"
 },
 "contract_schema_version": 3,
 "interface": {
  "usage": "pint-field-kit <input> [--out FILE]",
  "input": {
   "kind": "file",
   "format": "TSV 准备单",
   "contract": null
  },
  "output": {
   "kind": "stdout",
   "format": "HTML",
   "contract": {
    "media_type": "text/html",
    "root_type": "text",
    "required": {},
    "validation_profile": "safe_self_contained_xhtml_v1"
   }
  },
  "exit_codes": {
   "0": "success",
   "1": "user_error",
   "2": "internal_error"
  }
 },
 "capability": {
  "output_schema": "PintFieldKitXhtml"
 },
 "runtime": {
  "python": "3.12",
  "cpu_only": true,
  "offline": true
 },
 "verification": null
}
