{
 "manifest_version": 1,
 "name": "feedparser-tool",
 "version": "1.0.0",
 "summary": "将本地 RSS/Atom 订阅源文件解析为按原始顺序排列的条目标题与链接清单。",
 "source": {
  "url": "https://github.com/kurtmckee/feedparser",
  "resolved_commit": "14425f6851790184fbf7bbd8076de237d5f444f9",
  "license": "BSD-2-Clause",
  "distribution": "feedparser"
 },
 "interface": {
  "usage": "feedparser-tool <input> [--out FILE]",
  "input": {
   "kind": "file",
   "format": "RSS/Atom XML"
  },
  "output": {
   "kind": "stdout",
   "format": "TSV"
  },
  "exit_codes": {
   "0": "success",
   "1": "user_error",
   "2": "internal_error"
  }
 },
 "runtime": {
  "python": "3.12",
  "cpu_only": true,
  "offline": true
 },
 "verification": null
}
